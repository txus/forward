{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS / Metal",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-metal.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "macos-bench",
      "displayName": "macOS / Metal (benchmarks)",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build-bench",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux / CUDA",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-cuda.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "120"
      }
    },
    {
      "name": "linux-bench",
      "displayName": "Linux / CUDA (benchmarks)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build-bench",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FUSED_ROPE": "ON"
      }
    },
    {
      "name": "linux-clangd",
      "displayName": "Linux clangd database (CUDA-as-clang)",
      "description": "Compiles CUDA with clang so clangd can parse .cu files; emits compile_commands.json into build/clangd",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/clangd",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "environment": { "NIX_HARDENING_ENABLE": "" },
      "cacheVariables": {
        "CMAKE_CUDA_COMPILER": "clang++",
        "CMAKE_CUDA_HOST_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos",        "configurePreset": "macos" },
    { "name": "macos-bench",  "configurePreset": "macos-bench" },
    { "name": "linux",        "configurePreset": "linux" },
    { "name": "linux-bench",  "configurePreset": "linux-bench" },
    { "name": "linux-clangd", "configurePreset": "linux-clangd" }
  ]
}
