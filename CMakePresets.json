{
  "version": 6,
  "configurePresets": [
    {
      "name": "ninja",
      "displayName": "Main build",
      "description": "Platform-default build: Metal on macOS, CUDA (nvcc) on Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ninja-clangd",
      "displayName": "Clangd tooling build (Linux/CUDA)",
      "description": "Compiles CUDA with clang so clangd can parse .cu files; emits compile_commands.json into build/clangd",
      "environment": {
        "NIX_HARDENING_ENABLE": ""
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CUDA_COMPILER": "clang++",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "CMAKE_CUDA_ARCHITECTURES": "120",
        "CMAKE_CUDA_COMPILER_TOOLKIT_ROOT": "$env{CUDA_PATH}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BACKEND_CUDA": "ON",
        "CUDAToolkit_ROOT": "$env{CUDA_PATH}",
        "OpenMP_ROOT": "$env{OPENMP_ROOT}",
        "CLANG_RESOURCE_DIR": "$env{CLANG_RESOURCE_DIR}",
        "LIBCXX_INCLUDE": "$env{LIBCXX_INCLUDE}"
      }
    },
    {
      "name": "ninja-clangd-nocuda",
      "displayName": "Clangd-compatible build (no CUDA)",
      "description": "Clangd build for macOS or environments without CUDA",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clangd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{CLANGXX_PATH}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BACKEND_CUDA": "OFF",
        "OpenMP_ROOT": "$env{OPENMP_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja",
      "configurePreset": "ninja"
    },
    {
      "name": "ninja-clangd",
      "configurePreset": "ninja-clangd"
    },
    {
      "name": "ninja-clangd-nocuda",
      "configurePreset": "ninja-clangd-nocuda"
    }
  ]
}
